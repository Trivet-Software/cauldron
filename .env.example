# Cauldron environment variables
# Copy this file to .env.local and fill in real values.
# .env.local is gitignored; production reads from Railway's variable configuration.
#
# Only VITE_-prefixed variables are exposed to client code via Vite's import.meta.env.
# Variables without the VITE_ prefix are server-only and never bundled into the client.

# Clerk publishable key — ships to the client (required).
# `npx clerk env pull --file .env.local` writes it as CLERK_PUBLISHABLE_KEY;
# either name works.
VITE_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_here

# Base URL for the future backend API (optional, defaults to empty string)
VITE_API_BASE_URL=

# Clerk secret key — SERVER ONLY. Do NOT prefix with VITE_ or it leaks to the client.
# Staged for a future backend; unused in this skeleton.
CLERK_SECRET_KEY=your_clerk_secret_key_here

# --- Backend (services/api, services/worker) ---
# Local Supabase values come from `CLERK_DOMAIN=<your-clerk-domain> pnpm db:start`
# (or `supabase status -o env`). SUPABASE_SECRET_KEY is worker-only and server-only.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here
SUPABASE_SECRET_KEY=your_supabase_secret_key_here
# Comma-separated exact origins (scheme + host + port, no trailing slash) allowed by CORS and Clerk.
APP_ORIGINS=http://localhost:5173
# Comma-separated emails with developer access (optional).
DEVELOPER_EMAILS=

# LLM providers: openrouter | mock | record
PROVIDERS=openrouter
OPENROUTER_API_KEY=your_openrouter_api_key_here
LLM_COMPILE_MODEL=anthropic/claude-sonnet-5.5
LLM_DRAFT_MODEL=anthropic/claude-haiku-5.5
# Required when PROVIDERS is mock or record.
# MOCK_RECORDINGS_DIR=./recordings
# Optional; EMBEDDING_DIMENSIONS must match the items.embedding column size (1536).
# EMBEDDING_MODEL=openai/text-embedding-3-small
# EMBEDDING_DIMENSIONS=1536

# Direct database URL used by the integration tests (`pnpm test:db`).
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Storage policy tests (core/src/storage/storage.db.test.ts); values from `supabase status -o env`.
# If any is unset the storage suite is skipped.
TEST_SUPABASE_URL=http://127.0.0.1:54321
TEST_SUPABASE_PUBLISHABLE_KEY=your_local_publishable_key_here
TEST_SUPABASE_SECRET_KEY=your_local_secret_key_here
TEST_SUPABASE_JWT_SECRET=your_local_jwt_secret_here
