# Cauldron environment variables
# Copy this file to .env.local and fill in real values.
# .env.local is gitignored; production reads from Railway's variable configuration.
#
# Only VITE_-prefixed variables are exposed to client code via Vite's import.meta.env.
# Variables without the VITE_ prefix are server-only and never bundled into the client.

# Clerk publishable key — ships to the client (required).
# `npx clerk env pull --file .env.local` writes it as CLERK_PUBLISHABLE_KEY;
# either name works.
VITE_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_here

# Base URL for the future backend API (optional, defaults to empty string)
VITE_API_BASE_URL=

# Clerk secret key — SERVER ONLY. Do NOT prefix with VITE_ or it leaks to the client.
# Staged for a future backend; unused in this skeleton.
CLERK_SECRET_KEY=your_clerk_secret_key_here
